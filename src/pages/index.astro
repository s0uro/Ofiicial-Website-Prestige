---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteSchema, aggregateRatingBlock } from '../lib/schema';
import Section from '../components/primitives/Section.astro';
import Container from '../components/primitives/Container.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Badge from '../components/primitives/Badge.astro';
import Card from '../components/primitives/Card.astro';

import { Spotlight } from '../components/fx/Spotlight';
import { NumberTicker } from '../components/fx/NumberTicker';
import { Marquee } from '../components/fx/Marquee';
import TextReveal from '../components/fx/TextReveal.astro';
import LetterReveal from '../components/fx/LetterReveal.astro';
import { BackgroundBeams } from '../components/fx/BackgroundBeams';
import WhatsAppGlyph from '../components/primitives/WhatsAppGlyph.astro';
import { BentoGrid, BentoItem } from '../components/fx/BentoGrid';

import { WhatsAppButton } from '../components/cta/WhatsAppButton';
import { MapFlyTo } from '../components/fx/MapFlyTo';

import { buildWaUrl, TEL_AUTO, DISPLAY_PHONE_AUTO } from '../lib/wa';
import { fetchGoogleReviews } from '../lib/googleReviews';
import { SITE } from '../lib/seo';

const heroServices = [
  { label: 'Detailing', href: '/detailing' },
  { label: 'Mechanical', href: '/mechanical' },
  { label: 'Recovery', href: '/recovery' },
  { label: 'Buy & sell', href: '/buy-sell' },
  { label: 'Rentals', href: '/tourism/rentals' },
  { label: 'Transfers', href: '/tourism/taxi' },
];

const directionsUrl =
  'https://www.google.com/maps/dir/?api=1&destination=' +
  encodeURIComponent('S.PRESTIGE SERVICES, Kissonerga, Pafos');

const painAnchors = [
  {
    title: 'Hidden charges',
    body: 'The quote you get on WhatsApp is the number you pay. No surprise line items when you collect the keys.',
  },
  {
    title: 'Yellow headlights',
    body: 'UV and salt dull them in 18–24 months. Back to clear in about an hour — same morning, same week.',
  },
  {
    title: 'Mechanic silence',
    body: "You drop the car, then nothing. We call before any extra work — every time, no exceptions.",
  },
  {
    title: 'Vague pickup ETAs',
    body: '"Soon" is not a window. On the recovery line we give a real time — and we honour it, day or night.',
  },
];

const { reviews: googleReviews, rating: placeRating, userRatingCount: placeReviewCount } = await fetchGoogleReviews();

const testimonials = googleReviews.length > 0
  ? googleReviews.map((r) => ({ quote: r.quote, who: r.who, rating: r.rating }))
  : await getCollection('testimonials').then((raw) =>
      raw
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
        .map((t) => ({
          quote: t.data.quote,
          who: t.data.locationOrNationality
            ? `${t.data.name} · ${t.data.locationOrNationality}`
            : t.data.name,
          rating: t.data.rating ?? 5,
        }))
    );

const ratingSchemas: object[] = [];
if (placeRating !== null && placeReviewCount !== null && placeReviewCount > 0) {
  ratingSchemas.push(
    aggregateRatingBlock({
      ratingValue: placeRating,
      reviewCount: placeReviewCount,
      reviews: googleReviews.slice(0, 5).map((r) => ({
        author: r.who,
        rating: r.rating,
        body: r.quote,
      })),
    }),
  );
}
---
<BaseLayout
  lane="shared"
  title="S.Prestige Services"
  description="Detailing, mechanics, recovery, sales and rentals in Kissonerga, Pafos. Real starting prices, WhatsApp-first booking, no surprise charges at pickup."
  jsonLd={[websiteSchema(), ...ratingSchemas]}
>
  <!-- HERO -->
  <section class="relative isolate -mt-24 flex min-h-screen min-h-dvh items-center overflow-hidden bg-bg md:-mt-28">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      src="/videos/prestige-hero.mp4"
      poster="/imagery/prestige-hero-poster.webp"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    />
    <!-- MOBILE / TABLET: centered brand hero -->
    <div class="relative z-10 flex w-full flex-col items-center px-6 pt-10 text-center lg:hidden">
      <img
        src="/logo-mark.png"
        alt=""
        width="112"
        height="112"
        class="h-24 w-24 opacity-0 animate-fade-in-1 [filter:drop-shadow(0_3px_18px_rgba(0,0,0,0.6))]"
      />
      <div class="mt-3 flex flex-col items-center font-display font-semibold tracking-wide text-fg opacity-0 animate-fade-in-1 [text-shadow:0_1px_16px_rgba(0,0,0,0.6)]">
        <span class="text-3xl"><span class="text-gold">S.</span>Prestige</span>
        <span class="text-lg text-gold">Services</span>
      </div>

      <div class="mt-4 flex flex-col items-center gap-2.5 opacity-0 animate-fade-in-2 [text-shadow:0_1px_12px_rgba(0,0,0,0.7)]">
        <span
          class="js-hours inline-flex items-center gap-1.5 rounded-full border border-hairline/20 bg-bg/50 px-3 py-1 text-[11px] font-medium text-fg-muted backdrop-blur-sm"
          data-open="unknown"
        >
          <span class="js-hours-dot h-1.5 w-1.5 rounded-full bg-gold"></span>
          <span class="js-hours-text">Mon–Sat · 08:00–18:00</span>
        </span>
        <div class="flex items-center gap-2.5 text-[13px] text-fg-muted">
          <span class="inline-flex items-center gap-1">
            <svg viewBox="0 0 12 12" fill="currentColor" class="h-3.5 w-3.5 text-gold" aria-hidden="true"><path d="M6 0l1.5 4.5H12l-3.75 2.7 1.44 4.5L6 9 2.31 11.7l1.44-4.5L0 4.5h4.5z"/></svg>
            <span class="font-medium text-fg">{(placeRating ?? 4.9).toFixed(1)}</span> Google
          </span>
          <span aria-hidden="true" class="h-3 w-px bg-hairline/25"></span>
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 transition-colors hover:text-fg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-gold" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Kissonerga
          </a>
        </div>
      </div>

      <LetterReveal
        as="p"
        text="Detailing, mechanics, recovery, sales and rentals — one address in Kissonerga. Real starting prices, no surprise charges at pickup. WhatsApp answers the same day."
        delay={0.55}
        stagger={0.018}
        duration={0.45}
        className="mt-6 max-w-sm text-center font-medium leading-relaxed tracking-wide text-gold text-pretty text-lg [text-shadow:0_1px_14px_rgba(0,0,0,0.65)]"
      />

      <div class="mt-7 flex w-full max-w-xs flex-col gap-2.5 opacity-0 animate-fade-in-2">
        <a
          href={buildWaUrl('detailing.general')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center justify-center gap-2.5 rounded-md bg-[#25D366] px-6 text-base font-medium text-black shadow-sm"
        >
          <WhatsAppGlyph class="h-5 w-5" />
          Message us
        </a>
        <a
          href={`tel:${TEL_AUTO}`}
          class="inline-flex h-12 items-center justify-center gap-2.5 rounded-md border border-hairline/25 bg-bg/50 px-5 text-base font-medium text-fg backdrop-blur-sm"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {DISPLAY_PHONE_AUTO}
        </a>
      </div>
    </div>

    <!-- DESKTOP: rich hero -->
    <Container class="relative z-10 hidden py-24 md:py-28 lg:block">
      <div class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 opacity-0 animate-fade-in-1 [text-shadow:0_1px_14px_rgba(0,0,0,0.55)]">
          <Eyebrow>Kissonerga · Cyprus</Eyebrow>
          <span
            class="js-hours inline-flex items-center gap-1.5 rounded-full border border-hairline/15 bg-bg/40 px-2.5 py-1 text-[11px] font-medium text-fg-muted backdrop-blur-sm"
            data-open="unknown"
          >
            <span class="js-hours-dot h-1.5 w-1.5 rounded-full bg-gold"></span>
            <span class="js-hours-text">Mon–Sat · 08:00–18:00</span>
          </span>
        </div>

        <TextReveal
          as="h1"
          text={`Prestige cars.\nServiced, sold, rented.`}
          delay={0.3}
          className="mt-4 font-display text-display-1 font-semibold gold-gradient-text [filter:drop-shadow(0_2px_14px_rgba(0,0,0,0.5))] [&>span]:!whitespace-normal [&>span:nth-child(2)]:mt-1 [&>span:nth-child(2)]:text-[0.62em] [&>span:nth-child(2)]:font-medium [&>span:nth-child(2)]:tracking-tight [&>span:nth-child(2)]:text-gold"
        />
        <p class="mt-6 max-w-xl text-base text-fg-muted text-pretty opacity-0 animate-fade-in-2 [text-shadow:0_1px_14px_rgba(0,0,0,0.6)] sm:text-lg">
          One workshop in Kissonerga for detailing, mechanical work, 24/7
          recovery, used-car sales and rentals. Published starting prices,
          a quote before any work, and no surprise charges at pickup.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3 opacity-0 animate-fade-in-2">
          <a
            href={buildWaUrl('detailing.general')}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center gap-2.5 rounded-md bg-[#25D366] px-6 text-base font-medium text-black shadow-sm transition-transform duration-200 hover:scale-[1.02]"
          >
            <WhatsAppGlyph class="h-5 w-5" />
            Message us
          </a>
          <a
            href={`tel:${TEL_AUTO}`}
            class="inline-flex h-12 items-center gap-2.5 rounded-md border border-hairline/20 bg-bg/40 px-5 text-base font-medium text-fg backdrop-blur-sm transition-colors duration-200 hover:border-gold/50 hover:!text-gold"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {DISPLAY_PHONE_AUTO}
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-fg-muted opacity-0 animate-fade-in-2 [text-shadow:0_1px_12px_rgba(0,0,0,0.6)]">
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 12 12" fill="currentColor" class="h-3.5 w-3.5 text-gold" aria-hidden="true">
              <path d="M6 0l1.5 4.5H12l-3.75 2.7 1.44 4.5L6 9 2.31 11.7l1.44-4.5L0 4.5h4.5z"/>
            </svg>
            <span class="font-medium text-fg">{(placeRating ?? 4.9).toFixed(1)}</span>
            <span>on Google{placeReviewCount ? ` · ${placeReviewCount} reviews` : ''}</span>
          </span>
          <span aria-hidden="true" class="hidden h-3 w-px bg-hairline/20 sm:block"></span>
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition-colors hover:text-fg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-gold" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            {SITE.address.streetAddress.split(',')[0]}, Kissonerga — directions
          </a>
        </div>

        <nav class="mt-7 flex flex-wrap gap-2 opacity-0 animate-fade-in-4" aria-label="Services">
          {heroServices.map((s) => (
            <a
              href={s.href}
              class="rounded-full border border-hairline/15 bg-bg/40 px-3.5 py-1.5 text-sm text-fg-muted backdrop-blur-sm transition-colors duration-200 hover:border-gold/40 hover:!text-fg"
            >
              {s.label}
            </a>
          ))}
        </nav>
      </div>
    </Container>

    <script is:inline>
      // Live open/closed status in Cyprus local time (Mon–Sat 08:00–18:00).
      (function () {
        var pills = document.querySelectorAll('.js-hours');
        if (!pills.length) return;

        function cyprusNow() {
          return new Date(
            new Date().toLocaleString('en-US', { timeZone: 'Asia/Nicosia' }),
          );
        }

        function render() {
          var now = cyprusNow();
          var day = now.getDay(); // 0 Sun … 6 Sat
          var mins = now.getHours() * 60 + now.getMinutes();
          var OPEN = 8 * 60;
          var CLOSE = 18 * 60;
          var isWorkday = day >= 1 && day <= 6;
          var open = isWorkday && mins >= OPEN && mins < CLOSE;

          var label, colour, state;
          if (open) {
            var left = CLOSE - mins;
            label = left <= 60 ? 'Open · closes in ' + left + ' min' : 'Open now · closes 18:00';
            colour = 'rgb(var(--success))';
            state = 'true';
          } else {
            var opensMonday = day === 0 || (day === 6 && mins >= CLOSE);
            label = opensMonday ? 'Closed · opens Mon 08:00' : 'Closed · opens 08:00';
            colour = 'rgb(var(--danger))';
            state = 'false';
          }

          pills.forEach(function (pill) {
            var dot = pill.querySelector('.js-hours-dot');
            var text = pill.querySelector('.js-hours-text');
            if (text) text.textContent = label;
            if (dot) dot.style.background = colour;
            pill.dataset.open = state;
          });
        }

        render();
        setInterval(render, 60000);
      })();
    </script>

    <div class="pointer-events-none absolute inset-x-0 bottom-6 z-10 flex flex-col items-center gap-2 opacity-0 animate-fade-in-4 lg:hidden">
      <span class="u-label text-fg-muted">Scroll</span>
      <svg
        class="h-5 w-5 animate-bounce text-gold"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6" />
      </svg>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <Section bg="elev" spacing="tight">
    <div class="grid grid-cols-2 divide-x divide-hairline/10 md:grid-cols-4">
      <div class="flex flex-col items-center px-4 py-2 text-center first:pl-0 last:pr-0 md:px-8">
        <div class="font-display text-4xl text-gold md:text-5xl">
          <NumberTicker client:idle value={1200} suffix="+" />
        </div>
        <p class="mt-1.5 text-xs font-medium uppercase tracking-[0.15em] text-fg-muted">Cars detailed</p>
      </div>
      <div class="flex flex-col items-center px-4 py-2 text-center md:px-8">
        <div class="font-display text-4xl text-gold md:text-5xl">
          <NumberTicker client:idle value={8} suffix=" yr" />
        </div>
        <p class="mt-1.5 text-xs font-medium uppercase tracking-[0.15em] text-fg-muted">On the island</p>
      </div>
      <div class="flex flex-col items-center px-4 py-2 text-center md:px-8">
        <div class="flex items-baseline gap-1">
          <div class="font-display text-4xl text-gold md:text-5xl">
            <NumberTicker client:idle value={placeRating ?? 4.9} decimals={1} />
          </div>
          <svg viewBox="0 0 12 12" fill="currentColor" class="mb-1 h-4 w-4 shrink-0 self-end text-gold" aria-hidden="true">
            <path d="M6 0l1.5 4.5H12l-3.75 2.7 1.44 4.5L6 9 2.31 11.7l1.44-4.5L0 4.5h4.5z"/>
          </svg>
        </div>
        <p class="mt-1.5 text-xs font-medium uppercase tracking-[0.15em] text-fg-muted">Google rating</p>
      </div>
      <div class="flex flex-col items-center px-4 py-2 text-center last:pr-0 md:px-8">
        <div class="font-display text-4xl text-gold md:text-5xl">
          <NumberTicker client:idle value={0} prefix="€" />
        </div>
        <p class="mt-1.5 text-xs font-medium uppercase tracking-[0.15em] text-fg-muted">Hidden fees</p>
      </div>
    </div>
  </Section>

  <!-- TWO-LANE SPLIT -->
  <Section>
    <Eyebrow>Pick your lane</Eyebrow>
    <h2 class="mt-3 max-w-3xl h-section">
      Auto or tourism —<br class="hidden sm:block" /> both live here.
    </h2>
    <BentoGrid className="mt-10">
      <BentoItem
        href="/buy-sell"
        eyebrow="Auto · 01"
        title="Buy & sell cars"
        description="Photos on WhatsApp, same-day valuation. Honest numbers, clean paperwork."
        imageUrl="/imagery/bento-buysell.webp"
        imageAlt="Three luxury cars in a dimly lit showroom"
        className="md:col-span-2"
      />
      <BentoItem
        href="/tourism/rentals"
        eyebrow="Rentals · 02"
        title="Rentals"
        description="Airport pickup. Daily and weekly rentals, ask for price."
        imageUrl="/imagery/bento-rentals.webp"
        imageAlt="Cyprus coastal road at golden hour"
      />
      <BentoItem
        href="/tourism/taxi"
        eyebrow="Auto · 03"
        title="Transfers"
        description="Airport pickup, on-demand. Fixed quote on WhatsApp. No meter surprises."
        imageUrl="/imagery/bento-transfers.webp"
        imageAlt="Black Mercedes-Benz at night"
      />
      <BentoItem
        href="/detailing"
        eyebrow="Auto · 04"
        title="Detailing"
        description="Hand wash, polish, ceramic, headlight restoration. Published tiers, no upsell."
        imageUrl="/imagery/bento-detailing.webp"
        imageAlt="Polished black metallic paint with water beads"
      />
      <BentoItem
        href="/mechanical"
        eyebrow="Auto · 05"
        title="Mechanical"
        description="Diagnostics, servicing, brakes, suspension, pre-purchase checks. Quote before work."
        imageUrl="/imagery/bento-mechanical.webp"
        imageAlt="Wrench on a dark surface — workshop tools"
      />
      <BentoItem
        href="/recovery"
        eyebrow="Auto · 06"
        title="Recovery"
        description="24/7 flat-bed pickup across Pafos region. Real ETA. Drop where you need."
        imageUrl="/imagery/bento-recovery.webp"
        imageAlt="Car loaded onto a flat-bed tow truck at night"
      />
    </BentoGrid>
  </Section>

  <!-- PAIN ANCHORS -->
  <Section bg="elev">
    <Eyebrow>Why locals pick us</Eyebrow>
    <h2 class="mt-3 max-w-3xl h-section">
      We name the problem.<br class="hidden sm:block" /> Then we fix it.
    </h2>
    <Spotlight
      client:visible
      className="mt-10 grid grid-cols-1 gap-3 rounded-xl border border-hairline/10 bg-bg p-3 md:grid-cols-2 lg:grid-cols-4"
    >
      {painAnchors.map((p, i) => (
        <Card class="group/pain">
          <div class="flex items-start justify-between gap-2">
            <Badge>Pain</Badge>
            <span class="font-display text-3xl font-semibold leading-none text-gold/12 transition-colors duration-300 group-hover/pain:text-gold/25 select-none">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-4 font-display text-xl leading-snug text-fg">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.body}</p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-fg-muted/70 transition-colors duration-300 ease-out-expo group-hover/pain:text-gold">
            Our approach
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 transition-transform duration-300 ease-out-expo group-hover/pain:translate-x-0.5" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </div>
        </Card>
      ))}
    </Spotlight>
  </Section>

  <!-- TESTIMONIALS -->
  <Section spacing="tight">
    <Eyebrow>What locals say</Eyebrow>
    <div class="mt-8 overflow-hidden">
      <Marquee speed={28}>
        {testimonials.map((t) => (
          <div class="flex w-[290px] shrink-0 flex-col justify-between gap-4 rounded-lg border border-hairline/10 bg-bg-subtle p-5 shadow-card md:w-[310px] min-h-[190px]">
            <div>
              <div class="mb-3 flex gap-0.5">
                {[...Array(5)].map((_, i) => (
                  <svg viewBox="0 0 12 12" fill="currentColor" class:list={["h-3 w-3", i < t.rating ? "text-gold" : "text-fg-muted/25"]} aria-hidden="true">
                    <path d="M6 0l1.5 4.5H12l-3.75 2.7 1.44 4.5L6 9 2.31 11.7l1.44-4.5L0 4.5h4.5z"/>
                  </svg>
                ))}
              </div>
              <p class="font-display text-[15px] leading-snug text-fg md:text-base">&ldquo;{t.quote}&rdquo;</p>
            </div>
            <p class="u-label text-fg-muted">{t.who}</p>
          </div>
        ))}
      </Marquee>
    </div>
  </Section>

  <!-- LOCATION + FINAL CTA -->
  <section class="relative overflow-hidden bg-bg-elev py-24 md:py-32">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent" aria-hidden="true" />
    <BackgroundBeams />
    <Container class="relative z-10">
      <div class="grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <Eyebrow>Kissonerga, Cyprus</Eyebrow>
          <h2 class="mt-3 h-section">
            Tap, text, done.
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-hairline/12 bg-bg/50 p-5 backdrop-blur-sm transition-[border-color] duration-200 hover:border-gold/30">
              <Eyebrow>Address</Eyebrow>
              <div class="mt-3 font-medium leading-snug text-fg">
                Eustathios Plaza, Leoforos Chrisoneras, Kat.5
              </div>
              <div class="mt-1 text-sm text-fg-muted">Kissonerga, Pafos 8574</div>
            </div>
            <div class="rounded-xl border border-hairline/12 bg-bg/50 p-5 backdrop-blur-sm transition-[border-color] duration-200 hover:border-gold/30">
              <Eyebrow>Hours</Eyebrow>
              <div class="mt-3 font-medium leading-snug text-fg">
                Mon–Sat&nbsp;· 08:00–18:00
              </div>
              <div class="mt-1 text-sm text-fg-muted">Closed Sunday</div>
            </div>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <WhatsAppButton
              template="contact.auto"
              size="lg"
              variant="primary"
            >
              Message Auto
            </WhatsAppButton>
            <WhatsAppButton
              template="contact.tourism"
              size="lg"
              variant="secondary"
            >
              Message Rentals
            </WhatsAppButton>
          </div>
        </div>
        <MapFlyTo
          client:visible
          lat={SITE.geo.latitude}
          lng={SITE.geo.longitude}
          addressLines={[
            SITE.address.streetAddress,
            `${SITE.address.addressLocality}, ${SITE.address.addressRegion} ${SITE.address.postalCode}`,
            'Cyprus',
          ]}
          label={SITE.name}
          fallbackSrc="https://www.google.com/maps?q=S.PRESTIGE+SERVICES+Kissonerga+Cyprus&z=17&output=embed"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
