---
import { cn } from '../../lib/cn';
import { formatEUR } from '../../lib/currency';

export interface Props {
  amount?: number;
  /** Upper bound — renders "from €A–€B" (or "€A–€B" for exact). */
  to?: number;
  /** Renders "On request" instead of a number. */
  onRequest?: boolean;
  variant?: 'starting' | 'inline' | 'exact';
  period?: 'per-hour' | 'per-day' | 'per-week' | 'per-person' | 'per-group' | 'total';
  class?: string;
}

const {
  amount,
  to,
  onRequest = false,
  variant = 'starting',
  period,
  class: className,
} = Astro.props;

const priceText =
  amount == null
    ? ''
    : to != null
      ? `${formatEUR(amount)}–${formatEUR(to)}`
      : formatEUR(amount);

const periodLabels = {
  'per-hour': '/hr',
  'per-day': '/day',
  'per-week': '/wk',
  'per-person': '/pp',
  'per-group': '/group',
  total: '',
} as const;

const periodLabel = period ? periodLabels[period] : '';
---
{variant === 'starting' && (
  <div class={cn('inline-flex items-baseline gap-1.5', className)}>
    {onRequest ? (
      <span class="font-display text-xl font-semibold text-gold">On request</span>
    ) : (
      <>
        <span class="text-label font-semibold uppercase text-fg-muted">from</span>
        <span class="font-display text-2xl font-semibold text-gold">{priceText}</span>
        {periodLabel && <span class="text-sm text-fg-muted">{periodLabel}</span>}
      </>
    )}
  </div>
)}
{variant === 'inline' && (
  <span class={cn('inline-flex items-baseline gap-1', className)}>
    {onRequest ? (
      <span class="font-medium text-gold">On request</span>
    ) : (
      <>
        <span class="text-label font-semibold uppercase text-fg-muted">from</span>
        <span class="font-medium text-gold">{priceText}</span>
        {periodLabel && <span class="text-xs text-fg-muted">{periodLabel}</span>}
      </>
    )}
  </span>
)}
{variant === 'exact' && (
  <span class={cn('font-display text-2xl font-semibold text-gold', className)}>
    {onRequest ? 'On request' : priceText}{!onRequest && periodLabel && <span class="ml-1 text-sm font-normal text-fg-muted">{periodLabel}</span>}
  </span>
)}
