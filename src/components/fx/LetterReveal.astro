---
import { cn } from '../../lib/cn';

interface Props {
  text: string;
  className?: string;
  as?: 'p' | 'span' | 'div' | 'h1' | 'h2' | 'h3';
  /** Delay before the first letter starts (seconds). */
  delay?: number;
  /** Gap between each letter's reveal (seconds). */
  stagger?: number;
  /** Each letter's animation duration (seconds). */
  duration?: number;
}

const { text, className, as = 'p', delay = 0, stagger = 0.02, duration = 0.4 } = Astro.props as Props;
const Tag = as;
const words = text.split(' ');
let index = 0;
---
<Tag class={cn(className)} aria-label={text}>
  {words.map((word, wi) => (
    <>
      <span class="inline-block whitespace-nowrap">
        {Array.from(word).map((ch) => {
          const i = index++;
          return (
            <span
              aria-hidden="true"
              class="lr-char"
              style={`animation-delay: ${delay + i * stagger}s; animation-duration: ${duration}s;`}
            >
              {ch}
            </span>
          );
        })}
      </span>
      {wi < words.length - 1 && ' '}
    </>
  ))}
</Tag>

<style>
  .lr-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.3em);
    animation-name: letter-reveal-char;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    animation-fill-mode: forwards;
  }

  @keyframes letter-reveal-char {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lr-char {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
