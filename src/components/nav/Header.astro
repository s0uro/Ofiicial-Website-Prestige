---
import MobileMenu from './MobileMenu.tsx';
import WhatsAppGlyph from '../primitives/WhatsAppGlyph.astro';
import { DISPLAY_PHONE_AUTO, TEL_AUTO, WA_AUTO } from '../../lib/wa';

export interface Props {
  lane?: 'auto' | 'tourism' | 'shared';
}

const { lane = 'shared' } = Astro.props;

const primaryNav = [
  { label: 'Buy & Sell', href: '/buy-sell' },
  { label: 'Rentals', href: '/tourism/rentals' },
  { label: 'Detailing', href: '/detailing' },
  { label: 'Recovery', href: '/recovery' },
];

const moreNav = [
  { label: 'Mechanical', href: '/mechanical' },
  { label: 'Transfers', href: '/tourism/taxi' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact Us', href: '/contact' },
];

const allNavItems = [...primaryNav, ...moreNav];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---
<div
  id="site-header"
  data-lane={lane}
  class="fixed inset-x-3 top-3 z-30 transition-transform duration-300 ease-out-expo will-change-transform data-[hidden=true]:-translate-y-[150%] md:inset-x-6 md:top-5 lg:inset-x-10 xl:inset-x-16"
>
  <header
    id="site-header-bar"
    class="mx-auto flex h-16 max-w-[1140px] items-center justify-between gap-4 rounded-lg border border-hairline/10 bg-bg-elev/70 px-3 backdrop-blur transition-colors duration-300 supports-[backdrop-filter]:bg-bg-elev/55 data-[scrolled=true]:border-hairline/15 data-[scrolled=true]:bg-bg-elev/90 md:h-20 md:px-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="S.Prestige Services — home">
      <img src="/logo-mark.png" alt="" width="36" height="36" class="h-8 w-8 md:h-9 md:w-9" aria-hidden="true" />
      <span class="font-display text-base font-semibold text-fg md:text-lg">
        <span class="text-gold">S.</span>Prestige
      </span>
    </a>

    <nav class="hidden items-center gap-1 text-sm text-fg-muted lg:flex" aria-label="Primary">
      {primaryNav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-2 whitespace-nowrap transition-colors hover:bg-bg hover:text-fg',
              active && 'bg-bg text-gold',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}

      <details class="group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded-md px-3 py-2 text-sm text-fg-muted transition-colors hover:bg-bg hover:text-fg [&::-webkit-details-marker]:hidden"
        >
          More
          <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-2.5 w-2.5 transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
            <path d="M1 1.5l5 5 5-5" />
          </svg>
        </summary>
        <div class="absolute right-0 top-full z-10 mt-2 w-56 rounded-lg border border-hairline/10 bg-bg-elev py-2 shadow-card">
          {moreNav.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'block px-4 py-2 text-sm transition-colors hover:bg-bg hover:text-fg',
                  active ? 'text-gold' : 'text-fg-muted',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </div>
      </details>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={`tel:${TEL_AUTO}`}
        class="hidden shrink-0 flex-col items-end leading-tight transition-colors hover:text-gold xl:flex"
      >
        <span class="font-display text-sm font-semibold text-fg">{DISPLAY_PHONE_AUTO}</span>
        <span class="text-[11px] text-fg-muted">Mon&ndash;Sat &middot; 08:00&ndash;18:00</span>
      </a>
      <a
        href={`https://wa.me/${WA_AUTO}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Message us on WhatsApp"
        class="inline-flex h-10 items-center gap-2 rounded-md bg-[#25D366] px-3.5 text-sm font-medium text-black transition-transform hover:scale-[1.03]"
      >
        <WhatsAppGlyph class="h-4 w-4" />
        WhatsApp
      </a>
    </div>

    <div class="lg:hidden">
      <MobileMenu client:load items={allNavItems} />
    </div>
  </header>
</div>

<script>
  (function () {
    const wrap = document.getElementById('site-header') as HTMLElement | null;
    const bar = document.getElementById('site-header-bar') as HTMLElement | null;
    if (!wrap || !bar) return;
    const wrapEl = wrap;
    const barEl = bar;

    const REVEAL_ABOVE = 80; // always visible near the top
    const IGNORE_DELTA = 6; // ignore scroll jitter

    let lastY = window.scrollY;
    let ticking = false;

    function update() {
      const y = window.scrollY;
      const delta = y - lastY;

      barEl.dataset.scrolled = y > 24 ? 'true' : 'false';

      if (y <= REVEAL_ABOVE) {
        wrapEl.dataset.hidden = 'false';
      } else if (delta > IGNORE_DELTA) {
        wrapEl.dataset.hidden = 'true'; // scrolling down — hide
      } else if (delta < -IGNORE_DELTA) {
        wrapEl.dataset.hidden = 'false'; // scrolling up — reveal
      }

      lastY = y;
      ticking = false;
    }

    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  })();
</script>
