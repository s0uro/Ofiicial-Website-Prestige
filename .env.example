# Phase 1 does not require env vars.
#
# Contact page map animation (Mapbox GL fly-to). Without it the contact
# page falls back to the Google Maps embed.
#   PUBLIC_MAPBOX_TOKEN=pk.xxxxx
#
# Populated in Phase 6 (Deploy):
#   PLAUSIBLE_DOMAIN=
#   RESEND_API_KEY=           # if sell-your-car form lands on email
#   AIRTABLE_API_KEY=         # if form writes to Airtable
#   AIRTABLE_BASE_ID=
